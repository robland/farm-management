# Pilot configuration: copy to deploy/.env on the server and fill in. Never commit deploy/.env.
# Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(50))"

# Public domain (DNS A/AAAA record → this server). HTTPS certificates are automatic.
FMS_DOMAIN=pilote.example.org
FMS_ACME_EMAIL=exploitation@example.org
# Image tag deployed (git tag or short commit), used for rollback.
FMS_VERSION=latest

DJANGO_SECRET_KEY=
# Optional: separate key for the JWT tokens (rotated independently, see the runbook §8).
JWT_SIGNING_KEY=
DJANGO_DEBUG=false
LOG_LEVEL=INFO
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=30

POSTGRES_USER=fms
POSTGRES_PASSWORD=
POSTGRES_DB=fms

# Files (technical sheets, receipts, photos) are kept in the `files` Docker volume.
FMS_MAX_UPLOAD_MB=10
FMS_MAX_TECHNICAL_SHEET_MB=20

# AI assistant: disabled unless a provider is chosen (OPEN_QUESTIONS Q25).
FMS_AI_PROVIDER=null
ANTHROPIC_API_KEY=

# Backups written by the `backup` job (host directory, outside the Docker volumes).
BACKUP_HOST_DIR=/srv/fms/backups
BACKUP_RETENTION_DAYS=30
